  "item": [
    {
      "name": "01 - Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"email\": \"{{userEmail}}\",\n  \"telefono\": \"{{telefono}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set(\"userEmail\", \"juan.perez.\" + runId + \"@example.com\");",
              "pm.collectionVariables.set(\"telefono\", \"11\" + runId.slice(-8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Devuelve un ID de usuario\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.exist;",
              "    pm.collectionVariables.set(\"usuarioId\", data.id.toString());",
              "});"
            ]
          }
        }
      ]
    },
